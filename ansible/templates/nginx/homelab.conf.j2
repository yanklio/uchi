server {
    listen 80 default_server;
    server_name _ {{ homelab_tailnet_dns_suffix }} {{ homelab_tailnet_magicdns_name }};

    location = / {
        default_type text/html;
        return 200 '<!doctype html><html><head><meta charset="utf-8"><title>Homelab</title><style>body{font-family:system-ui,sans-serif;max-width:48rem;margin:4rem auto;padding:0 1rem;background:#111;color:#eee}a{color:#8ab4f8;font-size:1.25rem}li{margin:.75rem 0}</style></head><body><h1>Homelab</h1><ul><li><a href="http://{{ homelab_tailnet_magicdns_name }}:8080/">Glance</a></li><li><a href="http://{{ homelab_tailnet_magicdns_name }}:3000/">Chat</a></li><li><a href="http://{{ homelab_tailnet_magicdns_name }}:9119/">Hermes</a></li><li><a href="http://{{ homelab_tailnet_magicdns_name }}:8081/admin/">Pi-hole</a></li></ul></body></html>';
    }

    location / {
        return 404;
    }
}

server {
    listen 80;
    server_name glance.localhost glance.{{ homelab_domain }} glance.{{ homelab_tailnet_dns_suffix }};

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name chat.localhost chat.{{ homelab_domain }} chat.{{ homelab_tailnet_dns_suffix }};

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name hermes.localhost hermes.{{ homelab_domain }} hermes.{{ homelab_tailnet_dns_suffix }};

    location / {
        proxy_pass http://127.0.0.1:9119;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name pihole.localhost pihole.{{ homelab_domain }};

    location = / {
        return 302 /admin/;
    }

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
