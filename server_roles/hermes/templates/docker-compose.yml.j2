services:
  hermes:
    image: {{ hermes_image }}
    container_name: hermes
    command:
      - gateway
      - run
    ports:
      - "127.0.0.1:18642:8642"
{% if hermes_nginx_enabled | bool %}
      - "127.0.0.1:19119:9119"
{% else %}
      - "0.0.0.0:{{ hermes_dashboard_port }}:9119"
{% endif %}
    environment:
      HERMES_DASHBOARD: "1"
      HERMES_DASHBOARD_INSECURE: "{{ '1' if hermes_dashboard_insecure else '0' }}"
      HERMES_DASHBOARD_BASIC_AUTH_USERNAME: "{{ lookup('ansible.builtin.env', 'HERMES_DASHBOARD_BASIC_AUTH_USERNAME', default='') }}"
      HERMES_DASHBOARD_BASIC_AUTH_PASSWORD: "{{ lookup('ansible.builtin.env', 'HERMES_DASHBOARD_BASIC_AUTH_PASSWORD', default='') }}"
      HERMES_DASHBOARD_BASIC_AUTH_SECRET: "{{ lookup('ansible.builtin.env', 'HERMES_DASHBOARD_BASIC_AUTH_SECRET', default='') }}"
    volumes:
      - ../../state/hermes/data:/opt/data:z
      - ../../store/browser/playwright:/opt/hermes/.playwright:z
      - ../../store/models/hermes:/opt/models:z
    shm_size: 1g
    restart: always
