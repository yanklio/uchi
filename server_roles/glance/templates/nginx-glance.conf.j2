server {
{% for port in glance_nginx_ports | unique %}
    listen {{ port }};
{% endfor %}
    server_name glance.localhost glance.{{ homelab_domain | default('home') }}{% if homelab_tailnet_dns_suffix | default('') %} glance.{{ homelab_tailnet_dns_suffix }}{% endif %};

    location / {
        proxy_pass http://127.0.0.1:{{ glance_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
