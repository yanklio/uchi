# -------------------------------------------------------
# REQUIRED — Pi-hole web admin password
# -------------------------------------------------------
PIHOLE_PASSWORD=change_me_to_a_strong_password

# -------------------------------------------------------
# OPTIONAL — override defaults if your network is different
# -------------------------------------------------------
# HOMELAB_ACCESS_MODE=tailscale-only
# TZ=Europe/Warsaw
# DHCP_START=192.168.1.100
# DHCP_END=192.168.1.200
# DHCP_ROUTER=192.168.1.1
# DHCP_LEASE_TIME=24h
# PIHOLE_DOMAIN=home

# -------------------------------------------------------
# OPTIONAL — local service names served by Pi-hole DNS
# -------------------------------------------------------
# HOMELAB_IP=192.168.1.150
# HOMELAB_DOMAIN=home
# HOMELAB_DNS_NAMES=pihole,glance,chat,hermes
# HOMELAB_APPS=pi-hole,glance,open-webui,hermes
# HOMELAB_DRY_RUN=1
HOMELAB_APP_BIND=0.0.0.0

# DHCP is disabled by default. Only set DHCP_ACTIVE=true when Pi-hole should
# manage DHCP for the LAN.
DHCP_ACTIVE=false

# -------------------------------------------------------
# TAILSCALE-ONLY MODE — no LAN/router/Pi-hole DHCP exposure
# -------------------------------------------------------
# HOMELAB_APPS=pi-hole,glance,open-webui,hermes
# HOMELAB_ENABLE_PIHOLE_DNS=true
# HOMELAB_TAILNET_DNS_SUFFIX=gmk-de
# HOMELAB_TAILNET_MAGICDNS_NAME=gmk-de.tailff91da.ts.net
# HOMELAB_TAILNET_DNS_NAMES=glance,chat,hermes

PIHOLE_IMAGE=docker.io/pihole/pihole:2025.05.1
GLANCE_IMAGE=docker.io/glanceapp/glance:v0.8.4
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.6.26
HERMES_IMAGE=docker.io/nousresearch/hermes-agent:latest

HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change_me_to_a_strong_password
HERMES_DASHBOARD_BASIC_AUTH_SECRET=change_me_to_a_random_secret
