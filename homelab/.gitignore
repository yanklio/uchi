# Compatibility symlink to secrets/homelab.env.
.env
.env.*~

# Secrets are ignored and backed up by external backup tooling.
secrets/**
!secrets/.gitkeep

# Persistent app state is ignored and backed up by external backup tooling.
state/**
!state/.gitkeep

# Legacy app-local state paths kept ignored during migration.
apps/pi-hole/etc-pihole/**
apps/pi-hole/etc-dnsmasq.d/**
apps/open-webui/data/**
apps/hermes/data/**

# Shared models, browser downloads, and heavyweight caches are ignored.
store/**
!store/.gitkeep

# Local/manual export scratch space.
backups/**
!backups/.gitkeep
