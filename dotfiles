#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DOTFILES_DIR="${script_dir}"

if [[ -z "${1:-}" || "${1:-}" == "help" || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "Usage: $0 [command]"
  echo ""
  echo "Commands:"
  echo "  workstation  Run workstation setup"
  echo "  server       Run server setup"
  echo "  containers   Manage homelab containers"
  echo "  check        Run repository checks"
  echo "  help         Show this help"
  exit 0 2>/dev/null || exit 0
fi

case "$1" in
  workstation | server | check)
    "${DOTFILES_DIR}/scripts/$1.sh" "${@:2}"
    ;;
  containers)
    "${DOTFILES_DIR}/scripts/containers.sh" "${@:2}"
    ;;
  *)
    echo "Unknown command: $1" >&2
    exit 2 2>/dev/null || exit 2
    ;;
esac
